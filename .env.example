# Postgres
POSTGRES_USER=canvas
POSTGRES_PASSWORD=canvas
POSTGRES_DB=canvas_db

# Shared service endpoints
DATABASE_URL=postgresql+asyncpg://canvas:canvas@postgres:5432/canvas_db
MLFLOW_TRACKING_URI=http://mlflow:5000

# Service execution modes
BACKEND_EXECUTION_MODE=api
WORKER_EXECUTION_MODE=worker

# Sandbox (llm-sandbox) container resource limits — applied to warm pool
# containers at creation time. sandbox_mem_limit is a docker mem_limit string
# (e.g. "512m", "1g"); leave empty to disable the memory cap. sandbox_cpus is
# CPU cores (fractional allowed, converted to nano_cpus); set to 0 to disable.
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPUS=1.0

# Optional token for Hugging Face based models/providers
HF_TOKEN=

# Frontend dev/proxy configuration
VITE_USE_PROXY=true
VITE_API_HOST=
VITE_API_PROXY_TARGET=http://backend:8000
MLFLOW_PROXY_TARGET=http://mlflow:5000


# LLM provider defaults (Ollama on host)
# These are only the initial seed/fallback. Once you save provider settings in
# the app (Settings page), the stored configuration takes precedence and these
# values are ignored.
LLM_BASE_URL=http://192.168.1.120:11434
LLM_API_KEY=
LLM_MODEL=ollama_chat/gemma4:31b-cloud
LLM_PROVIDER_TYPE=ollama

# Pre-run LLM timeouts in seconds. Keep these short so unavailable providers
# fail quickly while generating conversation titles or validating configuration.
LLM_TITLE_TIMEOUT_SECONDS=3
LLM_VALIDATION_TIMEOUT_SECONDS=5

MEM0_LLM_MODEL=gemma4:31b-cloud
MEM0_EMBEDDER_MODEL=nomic-embed-text:latest
MEM0_EMBEDDER_DIMENSIONS=768

# Alternative: local ollama container (gpu profile)
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=ollama_chat/gemma4:31b
# MEM0_LLM_MODEL=gemma4:31b

# Alternative: OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_PROVIDER_TYPE=openai
# MEM0_LLM_MODEL=gpt-4o-mini
# MEM0_EMBEDDER_MODEL=text-embedding-3-small
# MEM0_EMBEDDER_DIMENSIONS=1536

# Alternative: OpenRouter
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=openrouter/google/gemma-4-31b-it:free
# LLM_PROVIDER_TYPE=openai
# MEM0_LLM_MODEL=google/gemma-4-31b-it:free
# MEM0_EMBEDDER_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# MEM0_EMBEDDER_DIMENSIONS=2048
