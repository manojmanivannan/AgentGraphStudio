        "name": "get_weather_forecast",
        "code": "from datetime import datetime, timedelta\nimport random\n\n\ndef get_weather_forecast(city: str) -> dict:\n    \"\"\"Generates a 10-hour temperature time series forecast for a given city.\"\"\"\n    forecast = []\n    current_time = datetime.now()\n\n    # Starting with a baseline temperature between 10\u00b0C and 20\u00b0C\n    current_temp = random.uniform(10.0, 20.0)\n\n    for hour in range(1, 11):\n        future_time = current_time + timedelta(hours=hour)\n\n        # Simulate slight hourly temperature fluctuations (-1.5\u00b0C to +1.5\u00b0C)\n        current_temp += random.uniform(-1.5, 1.5)\n\n        forecast.append(\n            {\n                \"timestamp\": future_time.strftime(\"%Y-%m-%d %H:00\"),\n                \"temperature_c\": round(current_temp, 1),\n            }\n        )\n\n    return {\"city\": city, \"forecast_series\": forecast}",
        "packages": "",
